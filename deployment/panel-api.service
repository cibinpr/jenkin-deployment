[Unit]
Description=MyPanel API
After=network.target panel-helper.service
Requires=panel-helper.service

[Service]
Type=simple
User=panel
Group=panel
WorkingDirectory=/opt/mypanel
Environment=NODE_ENV=production
Environment=PANEL_DB=/var/lib/mypanel/panel.db
Environment=PANEL_PORT=8080
Environment=HOST=127.0.0.1
Environment=PORT=8080
Environment=HELPER_SOCKET=/run/panel/helper.sock
ExecStart=/usr/bin/node packages/api/dist/server.js
Restart=always
RestartSec=5s
RuntimeDirectory=panel
RuntimeDirectoryMode=0755

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mypanel /run/panel

[Install]
WantedBy=multi-user.target
